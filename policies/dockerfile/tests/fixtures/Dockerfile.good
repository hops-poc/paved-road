# Trimmed, structurally-similar version of hello-world-svc/Dockerfile
# (digest-pinned base, non-root final USER). See scenario 2 and 5 in
# DECISIONS.md §5.
FROM oven/bun:1.2.4-slim@sha256:c377a08d0711e47c23a8ad8cf9a924cf9abeae4c9031dfa56be2f1786e0f8ce7 AS base
WORKDIR /app

COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile --production

COPY src ./src

USER bun
EXPOSE 3000
ENTRYPOINT ["bun", "run", "src/server.ts"]
